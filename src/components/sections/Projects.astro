---
import Section from '../ui/Section.astro';
import Tag from '../ui/Tag.astro';
import Icon from '../ui/Icon.astro';
import StatusBadge from '../ui/StatusBadge.astro';
import { projectSlug, type Cv } from '../../lib/cv';
import { useTranslations } from '../../i18n/ui';
import { projectPath, sectionIds } from '../../i18n/routes';

interface Props {
  cv: Cv;
}

const { cv } = Astro.props;
const { locale } = cv;
const t = useTranslations(locale);
---

<Section id={sectionIds.projects} index="03" command="show services" title={t('projects.title')}>
  <ul class="grid gap-5 md:grid-cols-2">
    {cv.projects.map((project) => {
      const slug = projectSlug(project);
      const p = project.data;
      return (
        <li class="panel group relative flex min-w-0 flex-col p-5 transition-colors hover:border-accent/60 sm:p-6">
          <div class="flex items-center justify-between gap-3">
            <p class="label-mono min-w-0 truncate">{p.kind}</p>
            <StatusBadge status={p.status} locale={locale} />
          </div>
          <h3 class="mt-3 text-xl font-bold tracking-tight">
            <a href={projectPath(locale, slug)} class="after:absolute after:inset-0 after:rounded-xl">
              {p.title}
            </a>
          </h3>
          <p class="mt-1 font-mono text-xs text-subtle">{p.period}</p>
          <p class="mt-3 flex-1 text-pretty text-muted">{p.summary}</p>
          <div class="mt-5 flex flex-wrap gap-1.5">
            {p.stack.slice(0, 6).map((s) => (
              <Tag>{s}</Tag>
            ))}
          </div>
          <div class="mt-5 flex items-center justify-between border-t border-line pt-4 text-sm">
            <span class="inline-flex items-center gap-1.5 font-medium text-accent">
              {t('projects.viewCase')}
              <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" />
            </span>
            {p.repo && (
              <a
                href={p.repo}
                class="relative z-10 inline-flex items-center gap-1.5 text-muted hover:text-fg"
                aria-label={`${t('projects.repo')}: ${p.title} (GitHub)`}
              >
                <Icon name="github" />
                {t('projects.repo')}
              </a>
            )}
          </div>
        </li>
      );
    })}
  </ul>
</Section>
