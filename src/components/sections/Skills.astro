---
import Section from '../ui/Section.astro';
import Tag from '../ui/Tag.astro';
import Topology, { type TopologySource } from '../../islands/Topology';
import { projectSlug, type Cv } from '../../lib/cv';
import { computeTopology } from '../../lib/topology';
import { useTranslations } from '../../i18n/ui';
import { sectionIds } from '../../i18n/routes';

interface Props {
  cv: Cv;
}

const { cv } = Astro.props;
const t = useTranslations(cv.locale);
const layout = computeTopology(cv.categories);
const emphasis = cv.categories.slice(0, 2).map((c) => c.id);
const categoryNames = Object.fromEntries(cv.categories.map((c) => [c.id, c.label]));

const sources: TopologySource[] = [
  ...cv.experience.map((e) => ({ id: e.id, label: e.company, skills: e.skills })),
  ...cv.projects.map((p) => ({
    id: projectSlug(p),
    label: p.data.short ?? p.data.title,
    skills: p.data.skills,
  })),
];
---

<Section id={sectionIds.skills} index="04" command="show topology" title={t('skills.title')}>
  <p class="mb-6 max-w-3xl text-pretty text-muted">{t('skills.intro')}</p>

  <!-- Mapa interactivo (pantallas grandes) -->
  <div class="hidden lg:block">
    <Topology
      client:visible
      layout={layout}
      sources={sources}
      emphasis={emphasis}
      categoryNames={categoryNames}
      labels={{
        title: t('skills.topology'),
        filter: t('skills.filter'),
        all: t('skills.all'),
        usedIn: t('skills.usedIn'),
        area: t('skills.area'),
        hint: t('skills.hint'),
        notUsed: t('skills.notUsed'),
        core: t('skills.core'),
      }}
    />
  </div>

  <!-- Vista en lista (mobile y tablet): mismos datos -->
  <ul class="grid gap-4 sm:grid-cols-2 lg:hidden">
    {cv.categories.map((cat, i) => (
      <li class="panel p-5">
        <h3 class:list={['label-mono', i < 2 && 'text-accent']}>{cat.label}</h3>
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {cat.items.map((item) => (
            <li>
              <Tag highlight={i < 2}>{item.name}</Tag>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</Section>
