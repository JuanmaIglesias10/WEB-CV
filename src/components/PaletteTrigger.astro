---
import type { PaletteItem } from '../islands/palette-types';
import type { PaletteLabels } from '../islands/CommandPalette';

interface Props {
  items: PaletteItem[];
  labels: PaletteLabels & { open: string };
}

const { items, labels } = Astro.props;
const { open, ...paletteLabels } = labels;
---

<button
  type="button"
  data-palette-trigger
  aria-haspopup="dialog"
  aria-keyshortcuts="Control+K Meta+K"
  class="inline-flex h-9 items-center gap-2 rounded-lg border border-line bg-elev px-2.5 text-sm text-muted transition-colors hover:border-accent hover:text-fg"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 20 20"
    class="size-4"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <circle cx="9" cy="9" r="5.5"></circle>
    <path d="m13.5 13.5 3.5 3.5" stroke-linecap="round"></path>
  </svg>
  <span class="sr-only sm:not-sr-only">{open}</span>
  <kbd
    data-palette-kbd
    class="hidden rounded border border-line bg-sunken px-1.5 py-0.5 font-mono text-[11px] text-subtle sm:inline"
  >
    Ctrl K
  </kbd>
</button>
<script
  type="application/json"
  data-palette-data
  set:html={JSON.stringify({ items, labels: paletteLabels })}
/>
<script>
  import type { PaletteHandle } from '../islands/palette-mount';

  // React y la paleta se descargan recién cuando el usuario la usa (o pasa el mouse por el botón).
  let handle: Promise<PaletteHandle> | null = null;
  const preload = () => import('../islands/palette-mount');
  const load = () => (handle ??= preload().then((m) => m.mountPalette()));

  document.addEventListener('click', (e) => {
    if ((e.target as Element | null)?.closest('[data-palette-trigger]')) void load().then((h) => h.open());
  });
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      void load().then((h) => h.toggle());
    }
  });
  document.addEventListener(
    'pointerover',
    (e) => {
      if ((e.target as Element | null)?.closest?.('[data-palette-trigger]')) void preload();
    },
    { passive: true },
  );
  // Al navegar, la paleta se vuelve a montar con los datos (idioma/enfoque) de la nueva página.
  document.addEventListener('astro:before-swap', () => {
    if (!handle) return;
    void handle.then((h) => h.unmount());
    handle = null;
  });
  document.addEventListener('astro:page-load', () => {
    if (/Mac|iPhone|iPad/.test(navigator.userAgent)) {
      document.querySelectorAll('[data-palette-kbd]').forEach((el) => (el.textContent = '⌘ K'));
    }
  });
</script>
