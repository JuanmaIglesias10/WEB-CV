---
interface Props {
  highlight?: boolean;
}
const { highlight = false } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-md border px-2 py-0.5 font-mono text-xs',
    highlight ? 'border-accent/40 bg-accent-soft text-fg' : 'border-line bg-sunken text-muted',
  ]}
>
  <slot />
</span>
