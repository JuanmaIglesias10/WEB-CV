  </svg>
)}
{name === 'download' && (
  <svg
    aria-hidden="true"
    viewBox="0 0 20 20"
    class={className}
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <path d="M10 3v10m0 0-4-4m4 4 4-4M4 16h12" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'mail' && (
  <svg
    aria-hidden="true"
    viewBox="0 0 20 20"
    class={className}
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <rect x="2.5" y="4.5" width="15" height="11" rx="2" />
    <path d="m3 5.5 7 5.5 7-5.5" stroke-linejoin="round" />
  </svg>
)}
{name === 'copy' && (
  <svg
    aria-hidden="true"
    viewBox="0 0 20 20"
    class={className}
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <rect x="6.5" y="6.5" width="10" height="10" rx="2" />
    <path d="M13.5 6.5V5a1.5 1.5 0 0 0-1.5-1.5H5A1.5 1.5 0 0 0 3.5 5v7A1.5 1.5 0 0 0 5 13.5h1.5" />
  </svg>
)}
{name === 'arrow-right' && (
  <svg
    aria-hidden="true"
    viewBox="0 0 20 20"
    class={className}
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <path d="M4 10h12m0 0-4.5-4.5M16 10l-4.5 4.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'arrow-left' && (
  <svg
    aria-hidden="true"
    viewBox="0 0 20 20"
    class={className}
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <path d="M16 10H4m0 0 4.5-4.5M4 10l4.5 4.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'external' && (
  <svg
    aria-hidden="true"
    viewBox="0 0 20 20"
    class={className}
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <path
      d="M11 4h5v5m0-5-7 7M14 12v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h3"
