---
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  status: 'active' | 'wip' | 'done';
  locale: Locale;
}

const { status, locale } = Astro.props;
const t = useTranslations(locale);
const styles = {
  active: 'border-ok/30 bg-ok-soft text-ok',
  wip: 'border-warn/30 bg-warn-soft text-warn',
  done: 'border-line bg-sunken text-muted',
} as const;
---

<span
  class:list={[
    'inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-0.5 font-mono text-xs',
    styles[status],
  ]}
>
  <span class="status-dot" data-pulse={status === 'active' ? '' : undefined} aria-hidden="true"></span>
  {t(`projects.status.${status}`)}
</span>
