---
import ThemeToggle from './ThemeToggle.astro';
import { otherLocale, useTranslations, type Locale } from '../i18n/ui';
import { homePath, sectionIds } from '../i18n/routes';

interface Props {
  locale: Locale;
  alternates: Record<Locale, string>;
}

const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
const other = otherLocale(locale);
const focusSlug = Astro.params.focus ?? '';
const home = homePath(locale, focusSlug);

const links = [
  { id: sectionIds.about, label: t('nav.about') },
  { id: sectionIds.experience, label: t('nav.experience') },
  { id: sectionIds.projects, label: t('nav.projects') },
  { id: sectionIds.skills, label: t('nav.skills') },
  { id: sectionIds.contact, label: t('nav.contact') },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4 sm:px-6">
    <a href={home} class="group flex items-center gap-2 font-mono text-sm font-semibold tracking-tight">
      <span class="status-dot text-ok" data-pulse aria-hidden="true"></span>
      <span>
        jmi<span class="text-subtle transition-colors group-hover:text-accent">@noc</span>
      </span>
      <span class="sr-only">— {t('nav.home')}</span>
    </a>

    <nav aria-label={t('nav.primary')} class="ml-6 hidden lg:block">
      <ul class="flex items-center gap-1 text-sm">
        {links.map((link) => (
          <li>
            <a
              href={`${home}#${link.id}`}
              class="rounded-md px-3 py-1.5 text-muted transition-colors hover:bg-sunken hover:text-fg"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <slot name="palette" />
      <a
        href={alternates[other]}
        hreflang={other}
        lang={other}
        aria-label={`${t('lang.short')} — ${t('lang.switch')}`}
        title={t('lang.switch')}
        class="inline-flex h-9 items-center rounded-lg border border-line bg-elev px-2.5 font-mono text-xs font-semibold text-muted transition-colors hover:border-accent hover:text-fg"
      >
        {t('lang.short')}
      </a>
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>
