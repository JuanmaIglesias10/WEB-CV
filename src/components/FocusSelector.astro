---
import type { FocusInfo } from '../lib/cv';
import { useTranslations, type Locale } from '../i18n/ui';
import { homePath } from '../i18n/routes';

interface Props {
  locale: Locale;
  focuses: FocusInfo[];
  current: string;
}

const { locale, focuses, current } = Astro.props;
const t = useTranslations(locale);
---

<div class="flex flex-wrap items-center gap-3">
  <span class="label-mono" id="focus-label">
    {t('hero.focusLabel')}
  </span>
  <nav aria-labelledby="focus-label">
    <ul class="flex flex-wrap gap-1 rounded-lg border border-line bg-elev p-1">
      {focuses.map((f) => {
        const active = f.id === current;
        return (
          <li>
            <a
              href={homePath(locale, f.slug)}
              aria-current={active ? 'page' : undefined}
              data-astro-prefetch
              class:list={[
                'block rounded-md px-3 py-1.5 font-mono text-[13px] transition-colors',
                active ? 'bg-accent text-accent-fg' : 'text-muted hover:bg-sunken hover:text-fg',
              ]}
            >
              {f.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</div>
