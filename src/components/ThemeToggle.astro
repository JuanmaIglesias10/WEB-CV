---
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<button
  type="button"
  data-theme-toggle
  data-label-dark={t('theme.toDark')}
  data-label-light={t('theme.toLight')}
  aria-label={t('theme.toDark')}
  title={t('theme.toDark')}
  class="inline-flex size-9 items-center justify-center rounded-lg border border-line bg-elev text-muted transition-colors hover:border-accent hover:text-fg"
>
  <!-- Luna (se muestra en tema claro) -->
  <svg
    aria-hidden="true"
    viewBox="0 0 20 20"
    class="size-4 dark:hidden"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <path d="M16.5 12.2A6.5 6.5 0 0 1 7.8 3.5a6.5 6.5 0 1 0 8.7 8.7Z" stroke-linejoin="round"></path>
  </svg>
  <!-- Sol (se muestra en tema oscuro) -->
  <svg
    aria-hidden="true"
    viewBox="0 0 20 20"
    class="hidden size-4 dark:block"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <circle cx="10" cy="10" r="3.5"></circle>
    <path
      d="M10 2v1.5M10 16.5V18M2 10h1.5M16.5 10H18M4.3 4.3l1.1 1.1M14.6 14.6l1.1 1.1M4.3 15.7l1.1-1.1M14.6 5.4l1.1-1.1"
      stroke-linecap="round"
    ></path>
  </svg>
</button>

<script>
  function syncLabels() {
    const dark = document.documentElement.classList.contains('dark');
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      const label = (dark ? btn.dataset.labelLight : btn.dataset.labelDark) ?? '';
      btn.setAttribute('aria-label', label);
      btn.title = label;
    });
  }

  document.addEventListener('click', (e) => {
    if ((e.target as Element | null)?.closest('[data-theme-toggle]')) window.__theme?.toggle();
  });
  document.addEventListener('themechange', syncLabels);
  document.addEventListener('astro:page-load', syncLabels);
</script>
